{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/en",
      "destination": "/index.en.html"
    },
    {
      "source": "/public/en",
      "destination": "/index.en.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
